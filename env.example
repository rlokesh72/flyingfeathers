# Database Configuration (REQUIRED)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flyingfeathers?retryWrites=true&w=majority

# Authentication (REQUIRED)
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your-secure-random-string-here-at-least-32-characters

# Alternative JWT Secret (optional if NEXTAUTH_SECRET is set)
JWT_SECRET=your-jwt-secret-here

# Email Configuration (Optional - for admin approval emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Email Settings (Optional)
ADMIN_EMAIL=admin@yourdomain.com
RESEND_FROM_EMAIL=Flying Feathers <noreply@yourdomain.com> 